# Versions and the image rule: the only place they are set (IMG-F-52). Environment variables of the
# same name override them.

# Node runtime of the kubeadm images. Keep in line with `kubeadmRuntime` in CAPI Navigator's
# versions.yaml (IMG-F-51).
CONTAINERD_VERSION="${CONTAINERD_VERSION:-2.4.2}"
RUNC_VERSION="${RUNC_VERSION:-1.5.2}"

# The rule for the images that are built and kept (IMG-F-60, matrix.sh): the two newest Ubuntu LTS
# and the two newest Debian releases (by hand, each needs its cloud image in build.sh), and the two
# newest patch releases of each Kubernetes minor below (resolved from dl.k8s.io). Keep the minors in
# line with the kubeadm catalog of CAPI Navigator's versions.yaml (IMG-F-50).
OPERATING_SYSTEMS="${OPERATING_SYSTEMS:-ubuntu-2604 ubuntu-2404 debian-13 debian-12}"
KUBERNETES_MINORS="${KUBERNETES_MINORS:-1.36 1.35}"
